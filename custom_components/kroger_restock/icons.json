{
  "entity": {
    "todo": {
      "grocery_list": {
        "default": "mdi:cart-variant"
      }
    },
    "sensor": {
      "in_cart": {
        "default": "mdi:cart-check"
      },
      "waiting": {
        "default": "mdi:timer-sand"
      },
      "needs_review": {
        "default": "mdi:help-circle-outline"
      },
      "unmatched": {
        "default": "mdi:barcode-off"
      },
      "last_stock_check": {
        "default": "mdi:store-clock"
      },
      "held": {
        "default": "mdi:calendar-clock"
      }
    },
    "button": {
      "sync": {
        "default": "mdi:cart-arrow-up"
      },
      "check_stock": {
        "default": "mdi:store-search"
      },
      "print_receipt": {
        "default": "mdi:receipt-text-outline"
      },
      "print_pdf": {
        "default": "mdi:file-pdf-box"
      }
    }
  },
  "services": {
    "scan_upc": {
      "service": "mdi:barcode-scan"
    },
    "add_item": {
      "service": "mdi:playlist-plus"
    },
    "resolve_item": {
      "service": "mdi:check-decagram"
    },
    "sync": {
      "service": "mdi:cart-arrow-up"
    },
    "readd_item": {
      "service": "mdi:cart-plus"
    },
    "check_stock": {
      "service": "mdi:store-search"
    },
    "print_list": {
      "service": "mdi:printer"
    }
  }
}
