{
  "entity": {
    "todo": {
      "grocery_list": {
        "default": "mdi:cart-variant"
      }
    },
    "sensor": {
      "in_cart": {
        "default": "mdi:cart-check"
      },
      "waiting": {
        "default": "mdi:timer-sand"
      },
      "needs_review": {
        "default": "mdi:help-circle-outline"
      },
      "unmatched": {
        "default": "mdi:barcode-off"
      },
      "last_stock_check": {
        "default": "mdi:store-clock"
      },
      "held": {
        "default": "mdi:calendar-clock"
      },
      "order": {
        "default": "mdi:shopping",
        "state": {
          "ready": "mdi:store-check",
          "out_for_delivery": "mdi:truck-delivery",
          "completed": "mdi:check-circle",
          "cancelled": "mdi:cancel",
          "none": "mdi:shopping-outline"
        }
      }
    },
    "button": {
      "sync": {
        "default": "mdi:cart-arrow-up"
      },
      "check_stock": {
        "default": "mdi:store-search"
      },
      "print_receipt": {
        "default": "mdi:receipt-text-outline"
      },
      "print_pdf": {
        "default": "mdi:file-pdf-box"
      }
    }
  },
  "services": {
    "scan_upc": {
      "service": "mdi:barcode-scan"
    },
    "add_item": {
      "service": "mdi:playlist-plus"
    },
    "resolve_item": {
      "service": "mdi:check-decagram"
    },
    "sync": {
      "service": "mdi:cart-arrow-up"
    },
    "readd_item": {
      "service": "mdi:cart-plus"
    },
    "check_stock": {
      "service": "mdi:store-search"
    },
    "print_list": {
      "service": "mdi:printer"
    },
    "mark_cart_received": {
      "service": "mdi:cart-check"
    },
    "check_cart_item": {
      "service": "mdi:cart-outline"
    },
    "cart_check": {
      "service": "mdi:clipboard-check-outline"
    },
    "set_quantity": {
      "service": "mdi:numeric"
    },
    "search_products": {
      "service": "mdi:magnify"
    }
  }
}
